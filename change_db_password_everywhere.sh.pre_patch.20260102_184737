#!/usr/bin/env bash
set -euo pipefail

# ============================================================
# change_db_password_everywhere.sh
#
# One script to:
#  - Change Postgres role passwords (postgres / erp_user / optional others)
#  - Update DB URLs in .env* and selected scripts (URL-encoding password safely)
#  - Optionally update platform registry fields (platform_tenants.db_user)
#  - Restart uvicorn and run quick checks
#
# Safe features:
#  - Disables bash history expansion (so '!' won't corrupt anything)
#  - Creates timestamped backups before editing files
#  - Dry-run mode
# ============================================================

set +H 2>/dev/null || true
set +o histexpand 2>/dev/null || true

APP_DIR="${APP_DIR:-/home/admin/trucking_erp}"
PG_CONTAINER="${PG_CONTAINER:-shared-postgres}"
PG_SUPERUSER="${PG_SUPERUSER:-postgres}"
PLATFORM_DB="${PLATFORM_DB:-trucking_erp}"
TENANT_DB="${TENANT_DB:-tenant_test_co}"

# Uvicorn
UVICORN_PORT="${UVICORN_PORT:-8000}"
UVICORN_CMD="${UVICORN_CMD:-/home/admin/trucking_erp/venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000}"
UVICORN_LOG="${UVICORN_LOG:-/tmp/truckerp_8000.log}"

# Modes
DRY_RUN="${DRY_RUN:-0}"         # 1 = print changes, do not write
RESTART_UVICORN="${RESTART_UVICORN:-1}"
RUN_CHECKS="${RUN_CHECKS:-1}"
UPDATE_PLATFORM_TENANTS_DB_USER="${UPDATE_PLATFORM_TENANTS_DB_USER:-0}"  # optional

# What passwords/users to change
CHANGE_POSTGRES_SUPERPASS="${CHANGE_POSTGRES_SUPERPASS:-0}"  # 1 = change postgres role password too
TARGET_APP_USER="${TARGET_APP_USER:-erp_user}"               # main app DB user
TARGET_APP_USER_CHANGE="${TARGET_APP_USER_CHANGE:-1}"        # 1 = change erp_user password
NEW_PASSWORD="${NEW_PASSWORD:-}"

usage() {
  cat <<USAGE
Usage:
  NEW_PASSWORD='YourNewPassword' bash change_db_password_everywhere.sh

Optional env vars:
  DRY_RUN=1                      (do not write changes)
  CHANGE_POSTGRES_SUPERPASS=1    (also change postgres role password)
  TARGET_APP_USER=erp_user
  TARGET_APP_USER_CHANGE=1
  UPDATE_PLATFORM_TENANTS_DB_USER=1  (updates public.platform_tenants.db_user to TARGET_APP_USER)
  RESTART_UVICORN=1
  RUN_CHECKS=1
USAGE
}

die() { echo "ERROR: $*" >&2; exit 1; }

need() { command -v "$1" >/dev/null 2>&1 || die "Missing required command: $1"; }

need docker
need python3
need sed
need grep
need awk

[[ -n "${NEW_PASSWORD}" ]] || { usage; die "NEW_PASSWORD is required"; }

timestamp() { date +"%Y%m%d_%H%M%S"; }

# URL encode password safely (so ? ! @ : / etc never break)
urlencode() {
  python3 - <<'PY'
import os, urllib.parse
pw = os.environ["PW"]
print(urllib.parse.quote(pw, safe=""))
PY
}

ENC_PW="$(PW="${NEW_PASSWORD}" urlencode)"

echo "== App dir: ${APP_DIR}"
echo "== Postgres container: ${PG_CONTAINER}"
echo "== Platform DB: ${PLATFORM_DB}"
echo "== Tenant DB: ${TENANT_DB}"
echo "== Target app user: ${TARGET_APP_USER}"
echo "== DRY_RUN=${DRY_RUN}"
echo

# --------- helpers ----------
docker_psql() {
  local db="$1"
  local sql="$2"
  docker exec -i "${PG_CONTAINER}" psql -U "${PG_SUPERUSER}" -d "${db}" -v ON_ERROR_STOP=1 -q -t -A -c "${sql}"
}

backup_file() {
  local f="$1"
  local b="${f}.bak.$(timestamp)"
  cp -a "$f" "$b"
  echo "$b"
}

# Replace password inside postgres URL value (handles postgresql+asyncpg / psycopg2 etc)
# Example:
#   postgresql+asyncpg://user:OLD@host:port/db?x=y
# becomes:
#   postgresql+asyncpg://user:ENC_PW@host:port/db?x=y
replace_pw_in_url_value() {
  local value="$1"
  local newpw="$2"
  # Replace only the password part between ":" after user and "@" before host.
  # Works even if user contains no ":" (should), assumes URL contains user:pass@
  python3 - <<'PY'
import os, re
val = os.environ["VAL"]
newpw = os.environ["NEWPW"]
# Match scheme://user:pass@...
m = re.match(r'^(?P<scheme>[^:]+)://(?P<user>[^:/?#]+):(?P<pw>[^@]+)@(?P<rest>.*)$', val)
if not m:
    print(val)
else:
    out = f"{m.group('scheme')}://{m.group('user')}:{newpw}@{m.group('rest')}"
    print(out)
PY
}

# Edit env-like files: update any line that looks like *DATABASE_URL or *DB_URL etc
update_urls_in_file() {
  local file="$1"
  local backup=""
  [[ -f "$file" ]] || return 0

  # Decide if file contains URLs we care about
  if ! grep -Eq 'postgresql(\+[^:]*)?://[^:]+:[^@]+@' "$file"; then
    return 0
  fi

  echo "== Updating URLs in: $file"
  if [[ "${DRY_RUN}" == "0" ]]; then
    backup="$(backup_file "$file")"
    echo "   backup: $backup"
  fi

  # Process line-by-line to preserve formatting/comments
  local tmp="${file}.tmp.$(timestamp)"
  : > "$tmp"

  while IFS= read -r line || [[ -n "$line" ]]; do
    if echo "$line" | grep -Eq 'postgresql(\+[^:]*)?://[^:]+:[^@]+@'; then
      # Extract the value after first '=' if it looks like VAR=URL
      if echo "$line" | grep -Eq '^[A-Za-z_][A-Za-z0-9_]*='; then
        var="${line%%=*}"
        val="${line#*=}"
        newval="$(VAL="$val" NEWPW="$ENC_PW" replace_pw_in_url_value)"
        echo "${var}=${newval}" >> "$tmp"
      else
        # Non-standard line; leave it unchanged
        echo "$line" >> "$tmp"
      fi
    else
      echo "$line" >> "$tmp"
    fi
  done < "$file"

  if [[ "${DRY_RUN}" == "1" ]]; then
    echo "   (dry-run) diff preview:"
    diff -u "$file" "$tmp" || true
    rm -f "$tmp"
  else
    mv "$tmp" "$file"
  fi
}

# Update platform registry (optional)
update_platform_registry() {
  if [[ "${UPDATE_PLATFORM_TENANTS_DB_USER}" != "1" ]]; then
    return 0
  fi
  echo "== Updating platform registry: public.platform_tenants.db_user -> ${TARGET_APP_USER}"
  local sql="UPDATE public.platform_tenants SET db_user='${TARGET_APP_USER}' WHERE id=1;"
  if [[ "${DRY_RUN}" == "1" ]]; then
    echo "   (dry-run) would run: $sql"
  else
    docker_psql "${PLATFORM_DB}" "$sql" >/dev/null
  fi
}

change_postgres_passwords() {
  echo "== Changing Postgres role passwords"
  if [[ "${TARGET_APP_USER_CHANGE}" == "1" ]]; then
    local sql="ALTER USER \"${TARGET_APP_USER}\" WITH PASSWORD '${NEW_PASSWORD}';"
    if [[ "${DRY_RUN}" == "1" ]]; then
      echo "   (dry-run) $sql"
    else
      docker_psql postgres "$sql" >/dev/null
      echo "   changed password for ${TARGET_APP_USER}"
    fi
  fi

  if [[ "${CHANGE_POSTGRES_SUPERPASS}" == "1" ]]; then
    local sql="ALTER USER \"${PG_SUPERUSER}\" WITH PASSWORD '${NEW_PASSWORD}';"
    if [[ "${DRY_RUN}" == "1" ]]; then
      echo "   (dry-run) $sql"
    else
      docker_psql postgres "$sql" >/dev/null
      echo "   changed password for ${PG_SUPERUSER}"
    fi
  fi
}

restart_uvicorn() {
  if [[ "${RESTART_UVICORN}" != "1" ]]; then
    return 0
  fi

  echo "== Restarting uvicorn on port ${UVICORN_PORT}"
  if [[ "${DRY_RUN}" == "1" ]]; then
    echo "   (dry-run) would pkill uvicorn and start: ${UVICORN_CMD}"
    return 0
  fi

  pkill -f "uvicorn app.main:app" 2>/dev/null || true
  nohup ${UVICORN_CMD} > "${UVICORN_LOG}" 2>&1 &
  echo "   started pid=$!"
}

run_checks() {
  if [[ "${RUN_CHECKS}" != "1" ]]; then
    return 0
  fi

  echo "== Quick checks"
  if [[ "${DRY_RUN}" == "1" ]]; then
    echo "   (dry-run) skipping checks"
    return 0
  fi

  echo "   - platform DB connectivity (inside container):"
  docker exec -i "${PG_CONTAINER}" psql -U "${TARGET_APP_USER}" -d "${PLATFORM_DB}" -v ON_ERROR_STOP=1 -c "SELECT 1;" >/dev/null
  echo "     OK"

  echo "   - tenant DB connectivity (inside container):"
  docker exec -i "${PG_CONTAINER}" psql -U "${TARGET_APP_USER}" -d "${TENANT_DB}" -v ON_ERROR_STOP=1 -c "SELECT 1;" >/dev/null
  echo "     OK"

  echo "   - show encoded password preview (not the real password):"
  echo "     ENC_PW=${ENC_PW}"

  echo "   - show current DATABASE_URL and POSTGRES_ADMIN_URL (if present) from .env:"
  grep -nE '^(DATABASE_URL|POSTGRES_ADMIN_URL)=' "${APP_DIR}/.env" 2>/dev/null || true
}

main() {
  cd "${APP_DIR}" || die "Cannot cd to ${APP_DIR}"

  echo "== Step A: Change role passwords in Postgres (container: ${PG_CONTAINER})"
  change_postgres_passwords
  echo

  echo "== Step B: Update URLs in all env files and common scripts (URL-encoded pw)"
  # env files
  for f in .env .env.* env.* *.env; do
    [[ -f "$f" ]] && update_urls_in_file "$f"
  done

  # common scripts where URLs might appear
  # (safe to scan; only edits lines that match postgres URL pattern)
  for f in scripts/*.sh scripts/*.py setup_*.sh step*.sh smoke_test.sh 2>/dev/null; do
    [[ -f "$f" ]] && update_urls_in_file "$f"
  done
  echo

  echo "== Step C: Optional platform registry updates"
  update_platform_registry
  echo

  echo "== Step D: Restart API (optional) + run checks"
  restart_uvicorn
  run_checks
  echo

  echo "== Done."
  echo "If provisioning still errors, run:"
  echo "  tail -n 120 ${UVICORN_LOG}"
}

main "$@"
